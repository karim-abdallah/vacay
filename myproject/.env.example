# Copy to .env and fill in your own values. Never commit the filled-in file.

VACAY_BACKEND_ENV=local
DJANGO_SECRET_KEY=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URL=http://localhost:3000/redirect/google

# OAuth — Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:3000/redirect/facebook
FACEBOOK_OAUTH_STATE=

# AWS
S3_BUCKET=
AWS_REGION=

# OpenAI
OPENAI_KEY=

# GCP service account — paste the full JSON blob as a single-line string
SERVICE_ACCOUNT_JSON=
